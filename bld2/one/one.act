// -----------------------------
Actor { name = main }

All { what = Ops actor = all }

// -----------------------------
Actor { name = all }

C { desc = "hi ${ops_id} x ${data}" }

Its { what = data actor = try attr = ._type eq = "=" value = List }

// -----------------------------
Actor { name = try }

C { desc = "${._type} ${.} good" }

This { path = . actor = try2 }

// -----------------------------
Actor { name = try2 }

C { desc = "${._type} ${._key} ${.} z" }

This { path = . actor = try3_float attr = ._type eq = "=" value = float64  }
This { path = . actor = try3_bool attr = ._type eq = "=" value = bool }

// -----------------------------
Actor { name = try3_bool }

C { desc = "${._type} ${._key} ${.} - bool" }

// -----------------------------
Actor { name = try3_float }

C { desc = "${._type} ${._key} ${.} - float" }

