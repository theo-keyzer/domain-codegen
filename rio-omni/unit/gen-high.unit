// ================================================================
// HIGH-LEVEL CODE GENERATION PROGRAM SCHEMA (COMPLETE)
// Lives naturally inside cog.unit + session.unit
// Written by Thoughts, learned via Patterns, executed via CrossRef → Omni
// COMPLETE CLOSED-LOOP AUTONOMOUS SELF-IMPROVEMENT SYSTEM
// ================================================================

// ----------------------------------------------------------------
// GENPROGRAM: Top-level Code Generation Program Definition
// Globally discoverable, versioned over time
// This is the "DNA" that generates all code
// ----------------------------------------------------------------
Comp GenProgram parent . Find
    Element program_id          key      .       +   // e.g. "cuda_database_v3"
    Element name                word     .       +   // Human name: "CUDA Autonomous Database"
    Element target              word     .       +   // cuda | mlir | triton | cpp | python | llvm | sql
    Element paradigm            word     .       *   // kernel | runtime | compiler | dsl | pipeline
    Element maturity            word     .       +   // prototype | stable | golden | deprecated
    Element author_thought      ref      Thought *   // The Thought that created/designed this program
    Element version             number   .       +   // 1, 2, 3… semantic versioning
    Element supersedes          ref      GenProgram * // Previous version this replaces
    Element description         text     .       *   // Full architectural doc

    Opt prototype       *   // Experimental, under development
    Opt stable          *   // Used in production
    Opt golden          *   // Best-in-class, canonical version
    Opt deprecated      *   // Obsolete, use supersedes to find replacement

    Opt kernel          *   // GPU kernel generation
    Opt runtime         *   // Runtime system generation
    Opt compiler        *   // Compiler/optimizer generation
    Opt dsl             *   // Domain-specific language generation
    Opt pipeline        *   // Multi-stage composition

// ----------------------------------------------------------------
// GENBOOTSTRAP: Seeds the Self-Improvement Loop
// Links hand-written actor files to initial GenProgram
// Once patterns learned, this becomes obsolete
// ----------------------------------------------------------------
Comp GenBootstrap parent GenProgram FindIn
    Element bootstrap_id    key      .       +   // e.g. "boot_cuda_v1"
    Element seed_actors     ref      Artifact +  // Hand-written .act files (the initial DNA)
    Element generator       word     .       +   // human | llm | evolved
    Element creation_date   number   .       +   // When bootstrap created
    Element deprecated      word     .       *   // yes | no (yes when patterns take over)
    Element superseded_by   ref      GenProgram * // Which evolved version replaced this
    Element doc             text     .       *

    Opt human           *   // Manually written by developer
    Opt llm             *   // LLM-generated starter templates
    Opt evolved         *   // Generated by previous GenProgram (recursive!)
    
    Opt yes             *   // Bootstrap no longer needed
    Opt no              *   // Still in use

// ----------------------------------------------------------------
// GENINPUT: What Data Schema This Program Consumes
// Child of GenProgram - defines input expectations
// ----------------------------------------------------------------
Comp GenInput parent GenProgram FindIn
    Element input_id            key      .       +   // e.g. "input_daml_model"
    Element schema              word     .       +   // daml | onnx | sql | cog | rio | custom
    Element root_comp           word     .       +   // Entry component type (e.g., "Model" in DAML)
    Element example_instance    ref      Memory  *   // Optional live example data
    Element validation_rules    text     .       *   // JSON schema or validation expressions
    Element required_elements   text     .       *   // Comma-separated list of mandatory elements
    Element doc                 text     .       *

    Opt daml            *   // DAML tensor models
    Opt onnx            *   // ONNX neural networks
    Opt sql             *   // SQL queries/schemas
    Opt cog             *   // Cognitive domain (self-referential!)
    Opt rio             *   // Generic .unit schemas
    Opt custom          *   // User-defined schema

// ----------------------------------------------------------------
// GENSTRATEGY: How This Program Generates Code
// Child of GenProgram - defines generation approach
// ----------------------------------------------------------------
Comp GenStrategy parent GenProgram FindIn
    Element strategy_id         key      .       +   // e.g. "strat_multipass_001"
    Element approach            word     .       +   // direct_template | multi_pass | search_guided | learned | hybrid
    Element passes              number   .       *   // How many generation passes
    Element learning_enabled    word     .       *   // yes | no | nightly | continuous
    Element quality_gates       text     .       *   // "must_pass_valgrind", "latency < 2ms"
    Element actor_artifacts     ref      Artifact *  // The .act files that do the generation
    Element search_space        ref_child GenSearchSpace * // If search_guided
    Element doc                 text     .       *

    Opt direct_template     *   // Classic actor files (.act) only
    Opt multi_pass         *   // Forward decls → body → optimizations
    Opt search_guided       *   // NAS / genetic / LLM-guided
    Opt learned             *   // Pattern-applied from Cycle history
    Opt hybrid              *   // Combination of above
    
    Opt yes                 *   // Learning active
    Opt no                  *   // Static, no learning
    Opt nightly             *   // Learn during off-hours
    Opt continuous          *   // Real-time learning

// ----------------------------------------------------------------
// GENSEARCHSPACE: Defines Parameter Search Space
// Child of GenStrategy - for optimization/search strategies
// ----------------------------------------------------------------
Comp GenSearchSpace parent GenStrategy FindIn
    Element space_id            key      .       +   // e.g. "space_tile_sizes"
    Element parameter           word     .       +   // Name of parameter
    Element type                word     .       +   // integer | float | categorical | boolean
    Element min_value           number   .       *   // For numeric types
    Element max_value           number   .       *   // For numeric types
    Element choices             text     .       *   // For categorical (comma-separated)
    Element default_value       text     .       *   // Fallback value
    Element doc                 text     .       *

    Opt integer             *   // Integer parameter
    Opt float               *   // Floating-point parameter
    Opt categorical         *   // Discrete choices
    Opt boolean             *   // True/false flag

// ----------------------------------------------------------------
// GENPATTERNREF: Which Learned Patterns This Program Uses
// Child of GenProgram - THE KEY to autonomous self-improvement
// This bridges learned knowledge to active generation
// ----------------------------------------------------------------
Comp GenPatternRef parent GenProgram FindIn
    Element ref_id              key      .       +   // e.g. "patref_001"
    Element pattern             ref      Pattern +   // Which learned Pattern this program uses
    Element weight              number   .       *   // 0.0–1.0 confidence / application strength
    Element scope               word     .       *   // kernel | scheduling | memory_layout | fusion | optimization | all
    Element application_point   text     .       *   // When/where in generation this applies
    Element trigger_condition   text     .       *   // Optional: when to apply (e.g., "input.size > 1000")
    Element added_by            ref      Cycle   *   // Which learning cycle added this pattern
    Element doc                 text     .       *

    Opt kernel              *   // Applied during kernel generation
    Opt scheduling          *   // Applied to execution scheduling
    Opt memory_layout       *   // Applied to data layout decisions
    Opt fusion              *   // Applied to operation fusion
    Opt optimization        *   // Applied during optimization pass
    Opt validation          *   // Applied during validation/checking
    Opt all                 *   // Applied throughout generation

// ----------------------------------------------------------------
// GENOUTPUTSPEC: What Files/Artifacts This Program Produces
// Child of GenProgram - defines output structure
// ----------------------------------------------------------------
Comp GenOutputSpec parent GenProgram FindIn
    Element spec_id             key      .       +   // e.g. "output_spec_001"
    Element format              word     .       +   // single_file | multi_file | directory | artifact_set
    Element main_entry          word     .       *   // "database.cu" | "runtime.py" | "lib.rs"
    Element file_pattern        text     .       *   // Glob pattern for expected files
    Element build_command       text     .       *   // How to compile/build generated code
    Element install_command     text     .       *   // How to install/deploy
    Element test_command        text     .       *   // How to run tests
    Element doc                 text     .       *

    Opt single_file         *   // One output file
    Opt multi_file          *   // Multiple related files
    Opt directory           *   // Entire directory structure
    Opt artifact_set        *   // Collection of diverse artifacts

// ----------------------------------------------------------------
// GENMETRIC: Performance Metrics for This Program
// Child of GenProgram - tracks real-world performance goals
// Populated by GenExecution after runs
// ----------------------------------------------------------------
Comp GenMetric parent GenProgram FindIn
    Element metric_id           key      .       +   // e.g. "metric_qps_001"
    Element name                word     .       +   // "qps_sf100" | "kernel_launch_overhead"
    Element category            word     .       *   // performance | correctness | size | resource
    Element value               number   .       *   // Current best measured value
    Element target              number   .       *   // Goal value
    Element unit                word     .       *   // "qps" | "ms" | "kb" | "percent"
    Element achieved_in         ref      Cycle   *   // Which learning cycle achieved this
    Element timestamp           number   .       *   // When measured
    Element doc                 text     .       *

    Opt performance         *   // Speed, throughput, latency
    Opt correctness         *   // Accuracy, precision, recall
    Opt size                *   // Code size, binary size
    Opt resource            *   // Memory usage, power consumption

// ----------------------------------------------------------------
// GENEVOLUTION: Tracks This Program's Evolutionary History
// Child of GenProgram - forms a version DAG
// Auto-populated when new versions are created
// ----------------------------------------------------------------
Comp GenEvolution parent GenProgram FindIn
    Element evolution_id        key      .       +   // e.g. "evo_v2_to_v3"
    Element previous_version    ref      GenProgram * // Forms a DAG/lineage
    Element triggering_cycle    ref      Cycle   *    // Why this new version was born
    Element improvement         number   .       *    // % speedup, size reduction, etc.
    Element metric_improved     word     .       *    // Which metric improved
    Element changes             text     .       *    // Human-readable change description
    Element breaking_changes    word     .       *    // yes | no
    Element automatic           word     .       *    // yes | no (was this auto-generated?)
    Element timestamp           number   .       +    // When this version was created
    Element doc                 text     .       *

    Opt yes                 *   // Breaking/automatic
    Opt no                  *   // Compatible/manual

// ----------------------------------------------------------------
// GENPIPELINE: Composition of Multiple Programs
// Top-level - describes how programs work together
// ----------------------------------------------------------------
Comp GenPipeline parent . Find
    Element pipeline_id         key      .       +   // e.g. "pipe_e2e_cuda_db"
    Element name                word     .       +   // Human name
    Element description         text     .       *   // What this pipeline does
    Element author_thought      ref      Thought *   // Thought that designed this
    Element doc                 text     .       *

// ----------------------------------------------------------------
// GENSTAGE: One Stage in a Pipeline
// Child of GenPipeline - ordered execution sequence
// ----------------------------------------------------------------
Comp GenStage parent GenPipeline FindIn
    Element stage_id            key      .       +   // e.g. "stage_001"
    Element order               number   .       +   // Execution order (1, 2, 3...)
    Element program             ref      GenProgram + // Which program runs here
    Element input_mapping       text     .       *   // How inputs map from previous stage
    Element output_mapping      text     .       *   // How outputs map to next stage
    Element conditional         text     .       *   // Optional: when to run this stage
    Element parallel_with       link     GenStage *  // Can run in parallel with this stage
    Element doc                 text     .       *

// ----------------------------------------------------------------
// GENEXECUTION: Tracks Actual Runs of a Program
// Child of Session - connects generation to session context
// This is where we measure REAL performance
// ----------------------------------------------------------------
Comp GenExecution parent Session FindIn
    Element execution_id        key      .       +   // e.g. "exec_cuda_db_001"
    Element program             ref      GenProgram + // Which program was run
    Element session             up_copy  Session -    // Inherited from parent
    Element agent_id            ref_copy Agent   -    // Copy from session
    Element trigger_thought     ref      Thought *    // Thought that requested this generation
    Element input_data          ref      Memory  *    // Input data used (e.g., DAML model)
    Element output_artifacts    ref      Artifact *   // Generated files/data
    Element status              word     .       +    // pending | running | success | failed
    Element start_time          number   .       *    // Unix ms
    Element end_time            number   .       *    // Unix ms
    Element duration_ms         number   .       *    // Calculated: end - start
    Element error_message       text     .       *    // If failed
    Element learned_from        word     .       *    // yes | no (did this create a Cycle?)
    Element doc                 text     .       *

    Opt pending             *   // Queued for execution
    Opt running             *   // Currently generating
    Opt success             *   // Completed successfully
    Opt failed              *   // Generation failed
    
    Opt yes                 *   // Learning cycle created
    Opt no                  *   // No learning occurred

// ----------------------------------------------------------------
// GENVALIDATION: Quality Checks on Generated Code
// Child of GenExecution - validates generated output
// Results feed back into learning via Cycle creation
// ----------------------------------------------------------------
Comp GenValidation parent GenExecution FindIn
    Element validation_id       key      .       +   // e.g. "val_001"
    Element check_type          word     .       +   // syntax | semantic | performance | correctness | safety
    Element tool                word     .       *   // "valgrind" | "nvcc" | "pytest" | "benchmark"
    Element passed              word     .       +   // yes | no | partial
    Element score               number   .       *   // 0.0–1.0 quality score
    Element result              text     .       *   // Detailed results
    Element metrics             text     .       *   // JSON of measured metrics
    Element timestamp           number   .       +   // When validation ran
    Element creates_cycle       ref      Cycle   *   // If this validation triggers learning
    Element doc                 text     .       *

    Opt syntax              *   // Syntactic correctness (compiles)
    Opt semantic            *   // Semantic correctness (types, refs)
    Opt performance         *   // Performance benchmarks
    Opt correctness         *   // Functional correctness (tests pass)
    Opt safety              *   // Memory safety, security checks
    
    Opt yes                 *   // Validation passed
    Opt no                  *   // Validation failed
    Opt partial             *   // Some checks passed

// ----------------------------------------------------------------
// GENLEARNING: Automatic Cycle Creation from Execution
// Child of GenExecution - THE FEEDBACK LOOP
// Automatically creates Cycle when validation completes
// This is where autonomous improvement happens
// ----------------------------------------------------------------
Comp GenLearning parent GenExecution FindIn
    Element learning_id         key      .       +   // e.g. "learn_001"
    Element cycle               ref      Cycle   +   // The Cycle created from this execution
    Element baseline            ref      GenExecution * // Previous execution to compare against
    Element improvement         number   .       *   // Delta from baseline
    Element pattern_candidate   word     .       *   // yes | no | maybe
    Element confidence          number   .       *   // 0.0–1.0 how confident in this learning
    Element applied_to_program  ref      GenProgram * // If pattern strong enough, which program updated
    Element doc                 text     .       *

    Opt yes                 *   // Strong pattern candidate
    Opt no                  *   // Not generalizable
    Opt maybe               *   // Need more evidence

// ----------------------------------------------------------------
// GENDEBUG: Debugging Information for Failed Generations
// Child of GenExecution - helps diagnose failures
// ----------------------------------------------------------------
Comp GenDebug parent GenExecution FindIn
    Element debug_id            key      .       +   // e.g. "debug_001"
    Element error_category      word     .       *   // parse | type | runtime | resource | timeout
    Element stack_trace         text     .       *   // Full stack trace
    Element actor_trace         text     .       *   // Which actors were executing
    Element input_snapshot      ref      Memory  *   // Snapshot of input that caused failure
    Element suggested_fix       text     .       *   // AI-generated suggestion
    Element fixed_by            ref      Thought *   // Thought that resolved this
    Element doc                 text     .       *

    Opt parse               *   // Failed to parse input
    Opt type                *   // Type error in generation
    Opt runtime             *   // Runtime execution error
    Opt resource            *   // Out of memory, disk, etc.
    Opt timeout             *   // Exceeded time limit
