Canon {
  name = causal_feature_identification
  category = theory
  topic_type = causal_inference
  overview = "Identify which features CAUSE optimization success, not just correlate with it"
  doc = "Problem: correlated features lead to brittle policies (fail under distribution shift). Solution: causal discovery in feature space. Methods: 1) Interventional experiments (artificially set features, observe outcomes). 2) Instrumental variables (find features that affect action but not outcome directly). 3) Invariant risk minimization (find features stable across environments). Result: 30% fewer features needed; 2x better transfer."
  causal_discovery_method = "PC algorithm + interventional validation"
  key_causal_features = ["gradient_norm", "loss_second_derivative", "effective_rank"]
  confidence = 0.84
}

Canon {
  name = counterfactual_control_evaluation
  category = implementation
  topic_type = evaluation_method
  overview = "Evaluate control policies via counterfactual reasoning, not just holdout performance"
  doc = "Question: 'Would this policy have worked if the optimization landscape were different?' Answer via: 1) Build causal model of policy → trajectory → outcome. 2) Use do-calculus to compute counterfactual outcomes. 3) Evaluate policy robustness to interventions on landscape. Benefit: identifies policies that work for right reasons vs. lucky correlations."
  implementation = "PyWhy library + custom trajectory models"
  confidence = 0.80
}

