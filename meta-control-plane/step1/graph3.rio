}

Canon {
  name = byzantine_resilient_control
  category = architecture
  topic_type = robust_systems
  overview = "Control planes that survive adversarial or malfunctioning nodes"
  doc = "In large distributed training, some nodes may be: 1) Faulty (hardware errors), 2) Adversarial (compromised), 3) Slow (stragglers). Byzantine-resilient control: 1) Redundant feature extraction (multiple nodes estimate same features). 2) Robust aggregation (median/trimmed-mean of control signals). 3) Reputation systems (downweight unreliable nodes). Guarantee: correct convergence even with f < n/3 Byzantine nodes."
  formal_guarantee = "Converges to ε-optimal under ≤33% Byzantine nodes"
  overhead = "2.5x compute for Byzantine-resilient version"
  confidence = 0.88
}

