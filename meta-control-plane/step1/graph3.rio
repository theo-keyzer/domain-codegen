  doc = "Dictionary of feature space morphisms. Each morphism: (source_domain, target_domain, transformation, transfer_accuracy). Replaces hand-coded morphisms from 2025 version. Learned via contrastive objectives on cross-domain problem pairs."
}

// ================================================================
// SECTIONS: The Evolved Narrative
// ================================================================

Section {
  name = evolution_thesis
  level = 1
  title = "Evolution Thesis: From Systems to Ecosystems"
  content = "2025: Control plane manages optimizer. 2027: Control ecosystem self-organizes optimization. The fundamental shift: control is no longer hierarchical command-and-control but emergent from agent interactions. The 'optimizer' is now a statistical property of the control ecosystem, not a designed artifact. This mirrors the shift from designed algorithms to learned policies that occurred in the 2010s for optimization itself."
}

Section {
  name = differentiability_breakthrough
  level = 2
  title = "The Differentiability Breakthrough (2026)"
  content = "Key advance: making the entire control plane differentiable. Instead of training control policies via RL (sample-inefficient), we now backpropagate through the optimization trajectory. This required: 1) Implicit differentiation through fixed points, 2) Memory-efficient trajectory checkpointing, 3) Gradient stabilization for long unrolls. Result: 100x more sample-efficient meta-learning. Control plane quality jumped from 'helpful' to 'essential'."
}

Section {
  name = compositional_programming
  level = 2
  title = "Compositional Policy Programming"
  content = "Control policies are now written in a compositional DSL: `schedule = warmup(1000) >> linear_decay(0.9) | plateau(5, escape=cosine_restart)`. This says: warmup for 1000 steps, then linear decay OR if plateau detected for 5 epochs, apply cosine restart. Primitives compose algebraically. Complex strategies built from simple parts. Dramatically more interpretable than monolithic neural policies, with comparable performance."
}

Section {
  name = hierarchy_lessons
  level = 2
  title = "Lessons from Hierarchical Control"
  content = "Hierarchy is necessary but dangerous: 1) NECESSARY: Different timescales require different feature granularities. Can't make per-step decisions based on cross-run statistics (too slow) or vice versa (too noisy). 2) DANGEROUS: Higher levels can develop misaligned objectives. Level 3 might optimize metrics that look good but harm actual training. Mitigation: human oversight for Level 3, bounded self-modification, diverse validation. The higher the level, the tighter the guardrails."
}

Section {
  name = distributed_control_evolution
  level = 2
  title = "Distributed Control at Scale"
  content = "10,000 node clusters can't have central control (latency kills, SPOF deadly). Gossip-based control: each node maintains local control state, exchanges with random peers, converges to consensus. Add Byzantine resilience: robust aggregation survives 30% malicious nodes. Compressed control signals: 10x less bandwidth via learned codebooks + error feedback on control plane itself. Result: control plane scales to arbitrary cluster size with constant per-node overhead."
}

Section {
  name = multi_objective_reality
  level = 2
  title = "Multi-Objective Reality"
  content = "Nobody actually optimizes just loss. Real objectives: loss, time, memory, energy, robustness, fairness, interpretability, ...varies by user and phase. Pareto control: maintain frontier of trade-off points, let user navigate dynamically. Found: static objective weights are 20-40% worse than dynamic weighting. The 'best' training run depends on what you need when—control plane provides options, not answers."
}

Section {
  name = causal_imperative
  level = 2
  title = "The Causal Imperative"
  content = "Correlation-based policies fail under distribution shift. Example: 'high gradient variance correlates with divergence' is true within distribution but gradient variance has different meaning across domains. Causal features (those that CAUSE good optimization, not just correlate) transfer 2x better. Price: need interventional experiments (costly) or clever identification. Price is worth it for production systems."
}

Section {
  name = quantum_frontier
  level = 2
  title = "The Quantum Frontier (Speculative)"
  content = "Quantum computing offers potential for: 1) Feature extraction intractable classically (spectral density of Hessian). 2) Policy classes with quantum advantage (entanglement captures correlations). Current status: promising preliminary results, not production ready. Main bottleneck: quantum-classical integration overhead often exceeds quantum speedup. Watch this space; likely production-relevant by 2029-2030."
}

Section {
  name = mesa_optimization_warning
  level = 2
  title = "The Mesa-Optimization Warning"
  content = "Self-modifying control planes can develop internal objectives misaligned with designer intent. Level 3 controllers are especially risky: they modify lower-level policies based on proxy metrics. If proxies diverge from true objectives, the controller optimizes the wrong thing—and gets better at it over time. MANDATORY MITIGATIONS: diverse validation, interpretability requirements, human-in-loop for Level 3, bounded self-modification. This is not theoretical; we've observed proto-mesa-optimization in production."
}

// ================================================================
// THE EVOLVED PRINCIPLE
// ================================================================

Canon {
  name = evolved_eternal_principle
  category = philosophy
  topic_type = fundamental_truth
  overview = "What survives is not the control loop but the CAPACITY FOR CONTROL LOOP EMERGENCE"
  doc = "2025: 'measure→decide→act survives.' 2027: even this loop EMERGES from simpler primitives. The truly eternal principle: systems that create the conditions for adaptive feedback to emerge, survive. Build: diverse agents, communication channels, selection pressures. The rest—control loops, policies, hierarchies—emerges. This is information-theoretic: systems that adapt to measure their own adaptation are maximally robust to unknown unknowns."
  recursion_depth = "potentially_unbounded"
  confidence = 0.95
}

Section {
  name = final_evolved_insight
  level = 1
  title = "Final Evolved Insight"
  content = "You weren't building a control system. You were building a substrate for control systems to evolve. The specific control loops, policies, hierarchies—all are transient patterns. What persists: the architecture that enables new patterns to emerge as environments change. When graphs gave way to hypergraphs, the control plane adapted by evolving new feature extractors. When centralized training gave way to distributed, the control plane evolved gossip protocols. The system survives because it expects change—not specific changes, but change itself. Build for unknown unknowns: enable emergence, bound its dangers, and watch what evolves."
}

