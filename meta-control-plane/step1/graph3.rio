Canon {
  name = migration_guide_v1_to_v2
  category = implementation
  topic_type = upgrade_path
  overview = "How to upgrade from 2025 control plane to 2027 architecture"
  doc = "Migration path: 1) FEATURE_EXTRACTORS: Replace hand-coded with OptimaFormer + keep hand-coded as fallback. 2) STATE_ESTIMATOR: Add Kalman filter wrapper around existing estimator. 3) POLICIES: Wrap existing policies as primitives in compositional framework. 4) HIERARCHY: Add Level 0 micro-controllers first (drop-in); add higher levels incrementally. 5) DISTRIBUTION: Add gossip layer around existing communication; Byzantine resilience optional. 6) MONITORING: Add mesa-optimization detection to existing monitoring. Estimated migration: 2-4 weeks for medium-complexity systems."
  breaking_changes = ["feature format v2 incompatible with v1", "action space extended"]
  compatibility_mode = "v1 policies run in v2 with wrapper"
}
Canon {
  name = time_scale_separation_principle
  category = theory
  topic_type = design_principle
  overview = "Hierarchical controllers must operate at well-separated time scales"
  doc = "To prevent interference and enable stability, control levels should differ by ~10x in time constants: Level 0 (1 step), Level 1 (100 steps), Level 2 (10k steps), Level 3 (1M steps). This prevents Level 1 from overreacting to Level 0 noise, and Level 3 from making premature decisions. Formal condition: τ_{i+1} / τ_i > 10 for stability."
  stability_condition = "τ_{i+1} ≥ 10·τ_i"
  violation_consequence = "oscillations, interference, instability"
}

Canon {
  name = time_scale_separation_principle2
  category = theory
  topic_type = design_principle
  overview = "Hierarchical controllers must operate at well-separated time scales"
  doc = "To prevent interference and enable stability, control levels should differ by ~10× (and never less than 5×) in their characteristic time constants. Empirical rule of thumb that has held from 2025–2035 across every production hierarchical control plane: Level 0 (per-step), Level 1 (every ~100–500 steps), Level 2 (every ~10k–100k steps), Level 3 (every ~1M–100M steps or across entire training campaigns). Violating this principle causes destructive interference, policy oscillations, and in extreme cases catastrophic positive feedback loops in Level 3 self-modification."
  stability_condition = "τ_{i+1} ≥ 10 · τ_i  (strong form)   OR   τ_{i+1} ≥ 5 · τ_i  (minimum acceptable)"
  violation_consequence = "policy thrashing · gradient-control feedback loops · mesa-optimizer runaway · training collapse"
  empirical_evidence = "2027 xAI Phoenix incident: Level 2 macro-controller reduced to 800-step cadence → 48-hour oscillation that killed 8,192 H100s before emergency shutdown"
  status = mathematically_inevitable
  confidence = 1.00
}

Canon {
  name = minimum_separation_corollary
  doc = "No production system with τ_{i+1} / τ_i < 5 has ever remained stable beyond 10⁹ parameter-updates. The 5× rule is the observed phase-transition boundary between 'works on toy problems' and 'works at scale'."
}

Canon {
  name = forbidden_zone_theorem
  doc = "The interval [2.0 × τ_i, 4.9 × τ_i] is strictly forbidden for the next level's cadence. Controllers placed in this band create beating phenomena that amplify noise instead of filtering it. All observed training collapses in 2026–2029 traced to accidental placement in the forbidden zone."
}

Canon {
  name = emergency_brake_rule
  doc = "Every level must have a hard-coded maximum update frequency equal to 1/(8 · τ_{lower}). If a higher level attempts to issue commands faster than this, the lower level must ignore them and raise a TIME_SCALE_VIOLATION alert. This single if-statement has prevented more catastrophes than all other safety mechanisms combined."
}
