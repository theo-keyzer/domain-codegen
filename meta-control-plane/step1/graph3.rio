// ================================================================
// INFORMATION-THEORETIC CONTROL BOUNDS
// ================================================================

Canon {
  name = no_free_lunch_for_control
  category = theory
  topic_type = impossibility_result
  overview = "No single control policy is optimal across all optimization landscapes"
  doc = "Formal theorem: For any control policy π, there exists optimization landscape L such that π is arbitrarily worse than the optimal policy for L. Implication: Universal optimizers don't exist; instead, we need: 1) Fast landscape classification, 2) Library of specialized policies, 3) Efficient policy selection/composition. This motivates the compositional approach."
  theorem = "∀π ∃L: Regret(π, L) = Ω(T)"
  positive_result = "For any landscape CLASS, near-optimal policy exists"
  confidence = 1.0
}

Canon {
  name = information_bottleneck_for_control
  category = theory  
  topic_type = theoretical_bound
  overview = "Optimal control uses minimal sufficient statistics of optimization trajectory"
  doc = "Information-theoretic formulation: I(Features; OptimalAction) ≤ H(OptimalAction). Optimal feature extractor maximizes predictability of optimal action while compressing trajectory information. Practical bound: for d-dimensional action space, optimal features require O(d log T) bits from T-step trajectory. Below this: underfitting. Above this: overfitting. Used to size feature extractors."
  formula = "min_{E} I(Trajectory; E(Trajectory)) s.t. I(E(Trajectory); OptimalAction) ≥ I(Trajectory; OptimalAction) - ε"
  confidence = 0.86
}

Canon {
  name = sample_complexity_of_meta_learning
  category = theory
  topic_type = learning_bound
  overview = "How many optimization problems needed to learn a good control policy?"
  doc = "Bound: To learn ε-optimal control policy with probability 1-δ, need O((d_policy/ε²) log(1/δ)) training problems, where d_policy = effective dimension of policy class. For neural network policies with regularization, d_policy ≈ number of non-near-zero parameters. Practical implication: start with simple policy class, increase complexity as more problems available."
  formula = "N_problems ≥ C · (d_policy/ε²) · log(1/δ)"
  practical_numbers = "For 1M-param policy, need ~10K problems for 10% suboptimality"
  confidence = 0.91
}

