  overview = "All optimization landscapes embed into a shared representation space via learned encoders"
  doc = "Rather than hand-crafted morphisms (2025), we now learn universal landscape encoders E: Landscape → Z where Z is a shared latent space. Properties: 1) Preserves optimization difficulty: d(E(L₁), E(L₂)) ≈ |Difficulty(L₁) - Difficulty(L₂)|. 2) Preserves optimal policy similarity. 3) Enables zero-shot policy transfer via prototype matching. Trained on corpus of 10M+ optimization problems with known solutions."
  formula = "E_θ: L ↦ Z, trained with contrastive loss: similar trajectories → similar embeddings"
  embedding_dimension = 256
  confidence = 0.91
}

