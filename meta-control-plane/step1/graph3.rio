  category = implementation
  topic_type = transfer_mechanism
  overview = "Control policies trained on one modality transfer to others via feature alignment"
  doc = "Procedure: 1) Train control policy π on source modality (e.g., dense NNs). 2) Collect (features_source, optimal_action) pairs. 3) Train feature aligner A: features_target → features_source using limited target data. 4) Deploy π(A(features_target)) on target modality. Empirical result: 85% of source policy performance with 5% of target training data."
  transfer_efficiency = "20x data reduction vs training from scratch"
