Canon {
  name = gossip_control_protocols
  category = architecture
  topic_type = distributed_systems
  overview = "Control decisions propagate via gossip protocols, not central coordination"
  doc = "For 10,000+ node training clusters, central control is infeasible (latency, single point of failure). Solution: gossip-based control. Each node: 1) Maintains local control state, 2) Periodically exchanges control signals with random peers, 3) Converges to consensus on control parameters via averaging. Theorem: Gossip-based control converges to centralized control with O(log n) communication rounds."
  convergence_guarantee = "ε-accurate consensus in O(log(n)/log(1/ε)) rounds"
  fault_tolerance = "Continues operating with up to 30% node failures"
  confidence = 0.94
}

Canon {
  name = compressed_control_signals
  category = implementation
  topic_type = efficiency_technique
  overview = "Control signals compressed via learned codebooks, not just gradients"
  doc = "Extension of error feedback to control signals: 1) Learn discrete codebook of 'control atoms' (common adjustment patterns). 2) Encode control decisions as codebook indices (2-4 bits vs 32-bit floats). 3) Apply error feedback to control signal residuals. Result: 10x reduction in control communication overhead with <1% degradation in policy quality."
  compression_ratio = "10-50x"
  codebook_size = 256
  confidence = 0.91
}

Link {
  concept = error_feedback_as_load_bearing
